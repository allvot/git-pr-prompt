# Theme: gruvbox — https://github.com/morhetz/gruvbox
#
# The bright variant of the dark palette: warm, high-contrast, retro. Reads well
# on gruvbox's own dark backgrounds and on plain black.

_gauge_palette \
  primary    '#d3869b'   `# bright purple — branch, merged PR` \
  secondary  '#83a598'   `# bright blue   — path` \
  remote     '#8ec07c'   `# bright aqua   — ahead/behind` \
  ok         '#b8bb26'   `# bright green  — staged, approved, open PR` \
  warn       '#fabd2f'   `# bright yellow — unstaged work, prompt char` \
  danger     '#fb4934'   `# bright red    — untracked, changes requested` \
  muted      '#928374'   `# gray          — separators, stash, draft`
