# Theme: nord — https://www.nordtheme.com
#
# Low-contrast arctic blues with muted accents. The frost blues carry the
# navigational roles (where you are, what the remote is doing); the aurora
# accents carry state.

_gauge_palette \
  primary    '#b48ead'   `# aurora purple  — branch, merged PR` \
  secondary  '#81a1c1'   `# frost 2        — path` \
  remote     '#88c0d0'   `# frost 1        — ahead/behind` \
  ok         '#a3be8c'   `# aurora green   — staged, approved, open PR` \
  warn       '#ebcb8b'   `# aurora yellow  — unstaged work, prompt char` \
  danger     '#bf616a'   `# aurora red     — untracked, changes requested` \
  muted      '#616e88'   `# nord comment   — separators, stash, draft`
