# Theme: dracula — https://draculatheme.com
#
# Saturated neon on dark. The loudest of the four — deliberately, since the
# prompt is meant to be readable at a glance in a wall of output.

_gauge_palette \
  primary    '#ff79c6'   `# pink    — branch, merged PR` \
  secondary  '#bd93f9'   `# purple  — path` \
  remote     '#8be9fd'   `# cyan    — ahead/behind` \
  ok         '#50fa7b'   `# green   — staged, approved, open PR` \
  warn       '#f1fa8c'   `# yellow  — unstaged work, prompt char` \
  danger     '#ff5555'   `# red     — untracked, changes requested` \
  muted      '#6272a4'   `# comment — separators, stash, draft`
