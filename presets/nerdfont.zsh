# Preset: nerdfont — GitHub's real icon set (Octicons), shipped inside every
# Nerd Font. Single-width, tints with your theme colors, looks native.
#
# Requires a patched font, e.g.:
#   brew install --cask font-jetbrains-mono-nerd-font
# then set it as your terminal font. Without one you get tofu boxes (□) —
# use the `emoji`, `github`, or `minimal` preset instead.
#
# Nerd Fonts v3 codepoints:
#   pr_open   nf-oct-git_pull_request         U+F407
#   pr_draft  nf-oct-git_pull_request_draft   U+F4DD
#   pr_merged nf-oct-git_merge                U+F419
#   pr_closed nf-oct-git_pull_request_closed  U+F4DC
#   approved  nf-oct-check_circle_fill        U+F4A4
#   changes   nf-oct-x_circle                 U+F52F
#   pending   nf-oct-eye                      U+F441

_zgp_fill ZGP_SYMBOLS \
  dirty            ''  \
  staged           ''  \
  untracked        ''  \
  ahead            ''  \
  behind           ''  \
  stash            ''  \
  pr_open          ''  \
  pr_draft         ''  \
  pr_merged        ''  \
  pr_closed        ''  \
  review_approved  ''  \
  review_changes   ''  \
  review_pending   ''  \
  branch_prefix    ' '
